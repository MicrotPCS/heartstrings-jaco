{
  "name": "heartstrings-jaco",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && tsc -b && vite build",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
